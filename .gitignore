# =============================================================================
# Large data files (never commit raw video or model weights)
# =============================================================================
yolov8n.pt
data/SoccerNet/
data/raw/*
data/clips/*
data/frames/*
data/processed/*
!data/raw/.gitkeep
!data/clips/.gitkeep
!data/frames/.gitkeep
!data/processed/.gitkeep

models/detection/*.pt
models/detection/*.pth
models/detection/*.onnx
models/detection/*.engine
models/tracking/*.pt
models/calibration/*.pkl
models/calibration/*.npy
models/*.pt
*.jpg
scratch_readme.md

# =============================================================================
